# Copy this to .env and fill in for each machine
# Get your values with: echo "PUID=$(id -u) PGID=$(id -g)"

PUID=1000
PGID=1000

# Host port that maps to container's 10680
HOST_PORT=80

# Path to the directory containing your docker credentials (config.json)
# Needed so watchtower can pull from ghcr.io
DOCKER_CONFIG_PATH=/home/youruser/.docker
